{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "customConditions": ["node"],
    "strict": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "com.local.yeelight.sdPlugin/bin",
    "types": ["node"]
  },
  "include": ["src/**/*"]
}
